{
  "name": "coptas-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sanity": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "sanity:seed": "tsx scripts/seed-sanity.ts",
    "sanity:seed:cli": "sanity dataset import sanity/seed/production.ndjson production --replace",
    "sanity:upload-logo": "sanity exec scripts/upload-logo.ts --with-user-token",
    "sanity:upload-logo:token": "tsx -r dotenv/config scripts/upload-logo.ts dotenv_config_path=.env.local",
    "sanity:cleanup-singletons": "sanity exec scripts/cleanup-singletons.ts --with-user-token"
  },
  "dependencies": {
    "@sanity/client": "^7.22.1",
    "@sanity/image-url": "^2.1.1",
    "clsx": "^2.1.1",
    "next": "^15.5.19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^5.31.1",
    "styled-components": "^6.4.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
